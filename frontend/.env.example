# Copy to .env.local and fill in. Vite only exposes VITE_* vars to the client.

# Public origin of the app; used for the TON Connect manifest at build time.
VITE_APP_URL=http://localhost:5000

# Backend API origin, e.g. https://api.example.com (no trailing slash).
# Production: required. The app is on Cloudflare Pages and the backend on its own
# domain behind Cloudflare Tunnel, so the backend must list the app origin in
# ALLOWED_ORIGINS (CORS). Empty = same origin as the app (dev proxy only).
# The contract the client expects: docs/backend-api.md.
VITE_API_URL=

# Development: the in-browser mock server (MSW) answers every endpoint and the
# game socket until the backend is ready. Toggle it on the main menu
# ("Mock server") to hit the real VITE_API_URL instead.


# Mock server (MSW): on by default via .env (VITE_MOCK_SERVER=true).
# Set VITE_MOCK_SERVER=false (e.g. a CI/CD variable) to drop it from the build.

# TON network: testnet (default in .env for now) or mainnet.
# VITE_TON_NETWORK=mainnet
