# Сервис по умолчанию делает всё сразу. Необязательно: MODE=consumer|broadcaster|watcher,
# чтобы запустить только одну часть (например, вынести подпись с ключом отдельно).

# Обязательно. В продакшене — amqps:// и отдельный пользователь с правами только на нужные очереди.
RABBITMQ_URL=amqp://chain:chain@localhost:5672/

# Топология (значения по умолчанию)
AMQP_EXCHANGE=core.events
AMQP_EXCHANGE_TYPE=direct
AMQP_QUEUE_TYPE=quorum
QUEUE_WITHDRAWALS=withdrawals
QUEUE_WITHDRAWALS_SIGNED=withdrawals.signed
QUEUE_WITHDRAWALS_RESULT=withdrawals.result
QUEUE_DEPOSITS=deposits

# Консьюмер
PREFETCH_COUNT=10
# CONSUMER_WORKERS=10
MAX_RETRIES=3
RETRY_BASE_DELAY=5s
HANDLER_TIMEOUT=30s

# Паблишер и соединение
PUBLISH_TIMEOUT=5s
AMQP_HEARTBEAT=10s
RECONNECT_INITIAL_DELAY=1s
RECONNECT_MAX_DELAY=30s

# Идемпотентность
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_CLEANUP_INTERVAL=10m

# Наблюдатель депозитов
WATCHER_POLL_INTERVAL=10s
WATCHER_BATCH_SIZE=100
# lt, с которого начать, если курсора в БД ещё нет (0 — вся история кошелька).
WATCHER_START_LT=0
# Кошелёк депозитов (один на всех, пользователь указывает свой код в комментарии).
TON_DEPOSIT_ADDRESS=

# MySQL — обязательна (история выводов, идемпотентность, курсор watcher). parseTime и UTC сервис включает сам.
MYSQL_DSN='chain:chain@tcp(localhost:3306)/chain'
MYSQL_MAX_OPEN_CONNS=10

# Сеть TON (broadcaster и watcher): toncenter | stub
TON_CLIENT=toncenter
TONCENTER_URL=https://testnet.toncenter.com
# Ключ добавим позже. Пусто — запросы без ключа (публичный лимит ~1 запрос/с).
TONCENTER_API_KEY=
TONCENTER_RPS=1
TONCENTER_TIMEOUT=10s

# Ожидание подтверждений. После CONFIRM_TIMEOUT неподтверждённый вывод уходит на ручной разбор (не failed).
CONFIRM_POLL_INTERVAL=5s
CONFIRM_TIMEOUT=15m
CONFIRM_BATCH_SIZE=50
# Окно последних транзакций горячего кошелька, в котором ищутся подтверждения (1 запрос за проход).
CONFIRM_SCAN_LIMIT=100
# Горячий кошелёк, с которого уходят выводы (обязателен для broadcaster с toncenter).
TON_WALLET_ADDRESS=

# Пока подключён только stub-подписант — без этого флага consumer не стартует.
ALLOW_STUB_SIGNER=true

METRICS_PORT=9090
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=30s
