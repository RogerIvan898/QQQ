# chain-service: отправка подписанных выводов в TON и наблюдение за депозитами.
# Подписи здесь нет: подписанные транзакции присылает сервис подписи через withdrawals.signed.
# Значения ниже — значения по умолчанию, если не сказано иное.

# ---------- Режим ----------

# Что запускать: all — broadcaster и watcher вместе; broadcaster — только отправка выводов;
# watcher — только депозиты. Обычно не задаётся.
MODE=all

# ---------- RabbitMQ ----------

# Адрес брокера. ОБЯЗАТЕЛЬНО. В продакшене — amqps:// и ОТДЕЛЬНЫЙ пользователь chain-service с правами
# на запись только в свои очереди. Его имя ставится в AMQP-свойство user_id каждого сообщения:
# RabbitMQ не даёт его подделать, и ядро по нему проверяет, что депозит/результат прислал chain-service.
RABBITMQ_URL=amqp://chain:chain@localhost:5672/
# Интервал heartbeat AMQP: как быстро заметить мёртвое соединение.
AMQP_HEARTBEAT=10s
# Exchange, к которому привязаны все очереди сервиса (routing key = имя очереди).
AMQP_EXCHANGE=core.events
# Тип exchange: direct | topic.
AMQP_EXCHANGE_TYPE=direct
# Тип очередей: quorum (надёжнее, рекомендуется) | classic. Должен совпадать с уже созданными очередями.
AMQP_QUEUE_TYPE=quorum

# Пользователь RabbitMQ сервиса подписи. ОБЯЗАТЕЛЬНО при TON_CLIENT=toncenter.
# Подписанные выводы принимаются только с этим AMQP user_id (RabbitMQ не даёт его
# подделать): иначе любой, кто может писать в exchange, занял бы request_id мусорным BOC.
SIGNER_RABBIT_USER=signer
# withdrawals.signed с x-single-active-consumer: читает только один экземпляр, второй
# ждёт в резерве. У уже созданной очереди аргумент не поменять — её нужно пересоздать.
AMQP_SINGLE_ACTIVE_CONSUMER=true

# Очередь, из которой берутся подписанные транзакции от сервиса подписи (WITHDRAW_SIGNED).
QUEUE_WITHDRAWALS_SIGNED=withdrawals.signed
# Очередь, куда публикуются результаты выводов (WITHDRAW_RESULT: sent / confirmed / failed).
QUEUE_WITHDRAWALS_RESULT=withdrawals.result
# Очередь, куда публикуются найденные депозиты (DEPOSIT_DETECTED).
QUEUE_DEPOSITS=deposits

# Повторы через delay-очереди для ошибок вне отправки (на практике редки: временные ошибки
# отправки broadcaster повторяет на месте, чтобы не нарушить порядок seqno). Потом — в DLQ.
MAX_RETRIES=3
# Задержка первого такого повтора; каждый следующий вдвое дольше (5s, 10s, 20s).
RETRY_BASE_DELAY=5s
# Максимальный размер тела входящего сообщения в байтах; больше — сразу в DLQ без разбора.
MAX_MESSAGE_BYTES=65536
# Сколько ждать подтверждения публикации от брокера (publisher confirm).
PUBLISH_TIMEOUT=5s
# Первая пауза перед переподключением к брокеру; дальше удваивается.
RECONNECT_INITIAL_DELAY=1s
# Максимальная пауза между попытками переподключения.
RECONNECT_MAX_DELAY=30s

# ---------- PostgreSQL ----------

# Строка подключения. ОБЯЗАТЕЛЬНО. Часовой пояс сессии (UTC) сервис ставит сам.
# В проде — sslmode=verify-full.
POSTGRES_DSN='postgres://chain:chain@localhost:5432/chain?sslmode=disable'
# Максимум одновременных соединений с PostgreSQL.
POSTGRES_MAX_OPEN_CONNS=10
# Сколько помнить обработанные message_id (защита от повторной обработки).
IDEMPOTENCY_TTL=24h
# Как часто удалять просроченные message_id.
IDEMPOTENCY_CLEANUP_INTERVAL=10m

# ---------- Сеть TON ----------

# Клиент сети: toncenter — настоящая сеть; stub — заглушка для локальной разработки (ничего не отправляет,
# но «подтверждает» выводы). stub запрещён при TONCENTER_URL основной сети.
TON_CLIENT=toncenter
# Адрес toncenter API: https://testnet.toncenter.com (testnet) или https://toncenter.com (mainnet).
# Только https:// (ключ API уходит в заголовке); http:// разрешён лишь для localhost.
TONCENTER_URL=https://testnet.toncenter.com
# Ключ toncenter API. Пусто — без ключа (публичный лимит ~1 запрос/с). Добавить позже.
TONCENTER_API_KEY=
# Собственный лимит запросов к toncenter в секунду. С ключом можно поднять.
TONCENTER_RPS=1
# Таймаут одного HTTP-запроса к toncenter.
TONCENTER_TIMEOUT=10s

# ---------- Отправка выводов (broadcaster) ----------

# Горячий кошелёк, с которого сервис подписи отправляет выводы. ОБЯЗАТЕЛЬНО при TON_CLIENT=toncenter.
# BOC, адресованный другому кошельку, не отправляется (уходит в DLQ).
TON_WALLET_ADDRESS=
# Как часто проверять подтверждения отправленных выводов.
CONFIRM_POLL_INTERVAL=5s
# Сколько ждать подтверждения. После — вывод НЕ объявляется failed, а уходит на ручной разбор
# (ошибка в логе): транзакция ещё может пройти.
CONFIRM_TIMEOUT=15m
# Сколько отправленных выводов сверять за один проход.
CONFIRM_BATCH_SIZE=50
# Сколько последних транзакций кошелька читать за проход для поиска подтверждений (1 запрос).
CONFIRM_SCAN_LIMIT=100

# ---------- Депозиты (watcher) ----------

# Кошелёк депозитов: пользователи переводят сюда TON с кодом в комментарии.
# ОБЯЗАТЕЛЬНО при TON_CLIENT=toncenter.
TON_DEPOSIT_ADDRESS=
# Как часто проверять новые транзакции кошелька депозитов.
WATCHER_POLL_INTERVAL=10s
# Сколько транзакций читать за один запрос.
WATCHER_BATCH_SIZE=100
# С какого lt начинать, если позиции в БД ещё нет. 0 — вся история кошелька;
# для уже используемого кошелька укажите текущий lt.
WATCHER_START_LT=0

# ---------- Прочее ----------

# Порт HTTP: /metrics (Prometheus), /healthz, /readyz.
METRICS_PORT=9090
# Интерфейс HTTP. Пусто — все интерфейсы (нужно в Docker). Вне контейнера лучше внутренний адрес:
# эндпоинты без авторизации.
METRICS_HOST=
# Уровень логов: debug | info | warn | error.
LOG_LEVEL=info
# Сколько ждать завершения текущих сообщений при остановке (SIGTERM).
SHUTDOWN_TIMEOUT=30s
