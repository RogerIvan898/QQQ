# chain-service в проде. Скопировать в chain-service.env (chmod 600), не коммитить.
# Все переменные описаны в chain-service/.env.example.
# RABBITMQ_URL, POSTGRES_DSN и METRICS_PORT задаёт docker-compose.yml.
TON_CLIENT=toncenter
# Подписанные выводы принимаются только от этого пользователя RabbitMQ (rabbitmq/users.sh).
SIGNER_RABBIT_USER=signer
TONCENTER_URL=https://toncenter.com
# Платный ключ toncenter: без него лимит ~1 запрос/с.
TONCENTER_API_KEY=
TONCENTER_RPS=5
# Горячий кошелёк выводов и кошелёк депозитов.
TON_WALLET_ADDRESS=
TON_DEPOSIT_ADDRESS=
# Для уже используемого кошелька депозитов — его текущий lt, иначе вся история.
WATCHER_START_LT=0
LOG_LEVEL=info
