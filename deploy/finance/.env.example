# VPS 2 — финансовая. Скопировать в .env (chmod 600), не коммитить.
# Пароли: openssl rand -hex 24

# Адрес этой VPS в приватной сети (Hetzner Cloud Network / vSwitch).
PRIVATE_IP=10.0.0.3

CHAIN_SERVICE_IMAGE=registry.gitlab.com/company-group7340831/poker/chain-service:latest
# Образ сервиса подписи (C++): задать, затем docker compose --profile signer up -d.
SIGNER_IMAGE=

POSTGRES_PASSWORD=

RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASS=
RABBITMQ_CHAIN_SERVICE_PASS=
RABBITMQ_CORE_PASS=
RABBITMQ_SIGNER_PASS=
