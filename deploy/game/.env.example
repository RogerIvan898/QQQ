# VPS 1 — игровая. Скопировать в .env (chmod 600), не коммитить.

# Образ бэкенда из GitLab Registry. Для релиза — тег, например :v1.2.0.
BACKEND_IMAGE=registry.gitlab.com/company-group7340831/poker/backend:latest

# Токен Telegram-бота: проверка initData при логине.
BOT_TOKEN=

# Origin фронта на Cloudflare Pages, без пути и слэша в конце.
ALLOWED_ORIGINS=https://app.example.com

# Токен Cloudflare Tunnel (Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=
